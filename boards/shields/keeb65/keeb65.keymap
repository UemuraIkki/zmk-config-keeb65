#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
                // R0: Esc 1 2 3 4 5 6 7 8 9 0 - ^ \ Del
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp INT3 &kp DEL
                // R1: Tab Q W E R T Y U I O P @ [ Back
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSPC
                // R2: Caps A S D F G H J K L ; : ] Enter
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp QUOT &kp NUHS &kp RET
                // R3: LShift Z X C V B N M , . / _ Up RShift
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp INT1 &kp UP &kp RSHFT
                // R4: LCtrl Fn Win LAlt Space RCtrl Left Down Right
                &kp LCTRL &mo 1 &kp LGUI &kp LALT &kp SPACE &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "FN";
            // 数字->F1-F12 / 矢印->PgUp,Home,PgDn,End
            // Q,W,E->BT0,1,2  Back->BT_CLR  Z->USB出力  X->BLE出力
            bindings = <
                // R0: Esc 1 2 3 4 5 6 7 8 9 0 - ^ \ Del
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans &trans
                // R1: Tab Q W E R T Y U I O P @ [ Back
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_CLR
                // R2: Caps A S D F G H J K L ; : ] Enter
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                // R3: LShift Z X C V B N M , . / _ Up RShift
                &trans &out OUT_USB &out OUT_BLE &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp PG_UP &trans
                // R4: LCtrl Fn Win LAlt Space RCtrl Left Down Right
                &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp END
            >;
        };
    };
};
